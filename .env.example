# TeamHappi environment variables.
# Copy to .env.local for local development. Never commit real values.
# Real values live in Vercel (per environment) and GitHub Actions secrets.

# --- Milestone 1 -------------------------------------------------------------
# Public base URL of this deployment (optional locally; defaults to http://localhost:3000)
APP_URL=http://localhost:3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Milestone 2 (Neon, London) — not used yet --------------------------------
# Runtime role (teamhappi_app: DML only, NOBYPASSRLS), pooled connection string
# DATABASE_URL=postgresql://teamhappi_app:<password>@<pooled-host>/<db>?sslmode=require
# Migration role (DDL), direct (unpooled) connection string — used by CI/migrations only
# DATABASE_MIGRATION_URL=postgresql://migrator:<password>@<direct-host>/<db>?sslmode=require

# --- Milestone 3 (Better Auth) — not used yet ---------------------------------
# BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
