# TeamHappi environment variables.
# Copy to .env.local for local development. Never commit real values.
# Real values live in Vercel (per environment) and GitHub Actions secrets.

# --- Milestone 1 -------------------------------------------------------------
# Public base URL of this deployment (optional locally; defaults to http://localhost:3000)
APP_URL=http://localhost:3000
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# --- Milestone 2 (Neon Free, London) -------------------------------------------
# Never put real values here. Real values live only in .env.local (gitignored),
# Vercel environment settings and GitHub Actions secrets.
#
# Application role teamhappi_app (DML only, NOBYPASSRLS, owns nothing).
# Use Neon's POOLED host (contains "-pooler").
DATABASE_URL=postgresql://teamhappi_app:<app-password>@<project-endpoint>-pooler.<region>.aws.neon.tech/teamhappi?sslmode=verify-full&channel_binding=require
# Migration role (owner; Neon's neondb_owner). Use the DIRECT host (no "-pooler").
# Used only by `npm run db:migrate`; never by the running app.
DATABASE_MIGRATION_URL=postgresql://<owner-role>:<owner-password>@<project-endpoint>.<region>.aws.neon.tech/teamhappi?sslmode=verify-full&channel_binding=require

# --- Tests ----------------------------------------------------------------------
# Optional. If unset, database tests start a throwaway local PostgreSQL 18.
# Must point at localhost (the harness refuses any other host).
# TEST_DATABASE_ADMIN_URL=postgresql://postgres:<password>@localhost:5432/postgres

# --- Milestone 3.1 (authentication, ADR-0008) -----------------------------------
# Authentication role teamhappi_auth (identity tables only, NOBYPASSRLS). POOLED host.
AUTH_DATABASE_URL=postgresql://teamhappi_auth:<auth-password>@<project-endpoint>-pooler.<region>.aws.neon.tech/teamhappi?sslmode=verify-full&channel_binding=require
# Signs session cookies and verification tokens. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=<at-least-32-random-characters>
#
# Local development: `npm run dev:db` writes .env.development.local (gitignored)
# with a local database and secret, which `next dev` prefers over .env.local.

# --- Milestone 5.2 (platform console role, ADR-0009) ----------------------------
# teamhappi_platform: tenant registry, platform audit and integration settings. POOLED host.
PLATFORM_DATABASE_URL=postgresql://teamhappi_platform:<platform-password>@<project-endpoint>-pooler.<region>.aws.neon.tech/teamhappi?sslmode=verify-full&channel_binding=require

# --- Milestone 5.3 (integrations, ADR-0011 stage 1) ------------------------------
# Providers the product owner has approved for live use, comma separated (for
# example: resend). Leave empty: only the test adapters can be switched on.
APPROVED_LIVE_PROVIDERS=
# Provider keys. Set ONLY after that provider is approved, only in Vercel,
# marked Sensitive, and never with a NEXT_PUBLIC_ prefix. Platform Admin shows
# whether each is set, never its value.
# RESEND_API_KEY=
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# PAYSTACK_SECRET_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# BEDROCK_ACCESS_KEY_ID=
# BEDROCK_SECRET_ACCESS_KEY=
# AZURE_OPENAI_API_KEY=
