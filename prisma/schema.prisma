// TeamHappi foundation schema (Milestone 2).
//
// Tenant isolation (ADR-0001):
// - Every tenant-owned table has tenant_id, UNIQUE (tenant_id, id), and composite
//   foreign keys (tenant_id, x_id) -> parent (tenant_id, id), so a row can never
//   reference another tenant's row.
// - RLS policies, grants and CHECK constraints are not expressible in Prisma.
//   They live in the reviewed SQL of each migration (prisma/migrations/*).
// - No cascading deletes on people or tenant data (data-model.md §4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Global (not tenant-owned)
// ---------------------------------------------------------------------------

model Tenant {
  id                 String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  slug               String             @unique
  legalName          String             @map("legal_name")
  status             TenantStatus       @default(active)
  timezone           String             @default("Europe/London")
  // Subscription and trial (M5.2): display only until billing is built.
  subscriptionStatus SubscriptionStatus @default(trial) @map("subscription_status")
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz
  plan               String?
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships         TenantMembership[]
  roles               Role[]
  sites               Site[]
  employees           Employee[]
  invitations         Invitation[]
  auditEvents         AuditEvent[]
  onboardingTemplates OnboardingTemplate[]

  @@map("tenant")
}

enum SubscriptionStatus {
  trial
  active
  past_due
  cancelled

  @@map("subscription_status")
}

enum TenantStatus {
  active
  suspended
  offboarding
  closed

  @@map("tenant_status")
}

// Identity. Column names follow Better Auth's core user model so Milestone 3
// can adopt this table. At least one of email / phone_number is required (CHECK in SQL).
model User {
  id               String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name             String
  // Unique as Better Auth requires (M3.1). The case-insensitive index from M2
  // (lower(email)) stays; emails are stored lower-cased.
  email            String?  @unique
  emailVerified    Boolean  @default(false) @map("email_verified")
  // M6: how the address was confirmed ("email" or "invitation" link).
  emailVerifiedVia String?  @map("email_verified_via")
  phoneNumber      String?  @map("phone_number")
  image            String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships TenantMembership[]
  sessions    Session[]
  accounts    Account[]

  // M5.1 (ADR-0013): platform staff and MFA, managed only by teamhappi_auth.
  platformStaff PlatformStaff?    @relation("PlatformStaffUser")
  staffGranted  PlatformStaff[]   @relation("PlatformStaffGrantedBy")
  mfa           UserMfa?
  recoveryCodes MfaRecoveryCode[]

  @@map("user")
}

// ---------------------------------------------------------------------------
// Authentication (Milestone 3.1, ADR-0008). Global tables used ONLY by the
// teamhappi_auth database role through Better Auth. The application role has no
// grants on them (it never sees sessions, password hashes or tokens).
// Field names follow Better Auth's core schema.
// ---------------------------------------------------------------------------

model Session {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  token         String    @unique
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  // When this session last passed MFA (M5.1). Elevation ends with the session.
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

// Credentials. For email/password sign-in, providerId = "credential" and
// password holds the library-managed hash.
model Account {
  id                    String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

// Email-verification (and later reset) tokens.
model Verification {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([identifier])
  @@map("verification")
}

// Database-backed authentication rate limiting (no Redis).
model RateLimit {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

// Permission catalogue, defined in code (src/lib/permissions). Read-only to the app.
model Permission {
  code        String @id
  description String

  rolePermissions RolePermission[]

  @@map("permission")
}

// ---------------------------------------------------------------------------
// Tenant-owned
// ---------------------------------------------------------------------------

model TenantMembership {
  id        String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    MembershipStatus @default(active)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                 User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  roleAssignments      RoleAssignment[]
  employee             Employee?
  ownedOnboardingCases OnboardingCase[] @relation("OnboardingCaseOwner")
  onboardingTasks      OnboardingTask[]
  rtwChecksDone        RtwCheck[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@index([userId])
  @@map("tenant_membership")
}

enum MembershipStatus {
  invited
  active
  suspended
  left

  @@map("membership_status")
}

model Role {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]
  invitations Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@map("role")
}

model RolePermission {
  tenantId       String @map("tenant_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")

  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  permission Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, roleId, permissionCode])
  @@map("role_permission")
}

// siteId null = tenant-wide; otherwise scoped to one site.
model RoleAssignment {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  siteId       String?  @map("site_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  role       Role             @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  site       Site?            @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, membershipId])
  @@map("role_assignment")
}

model Site {
  id          String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String     @map("tenant_id") @db.Uuid
  code        String
  name        String
  timezone    String     @default("Europe/London")
  status      SiteStatus @default(active)
  // Business location (M4.2). No personal data.
  addressLine String?    @map("address_line")
  town        String?
  postcode    String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  teams               Team[]
  roleAssignments     RoleAssignment[]
  primaryFor          Employee[]
  invitations         Invitation[]
  onboardingTemplates OnboardingTemplate[]
  onboardingCases     OnboardingCase[]
  vacancies           Vacancy[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("site")
}

enum SiteStatus {
  active
  archived

  @@map("site_status")
}

model Team {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  siteId    String   @map("site_id") @db.Uuid
  name      String
  archived  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  site    Site         @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  members TeamMember[]

  @@unique([tenantId, id])
  @@unique([tenantId, siteId, name])
  @@map("team")
}

model TeamMember {
  tenantId   String   @map("tenant_id") @db.Uuid
  teamId     String   @map("team_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  team     Team     @relation(fields: [tenantId, teamId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([tenantId, teamId, employeeId])
  @@index([tenantId, employeeId])
  @@map("team_member")
}

// Core people record. A login (membership) is optional: some staff never sign in.
model Employee {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  membershipId   String?          @map("membership_id") @db.Uuid
  employeeNumber String           @map("employee_number")
  givenName      String           @map("given_name")
  familyName     String           @map("family_name")
  preferredName  String?          @map("preferred_name")
  email          String?
  phoneNumber    String?          @map("phone_number")
  jobTitle       String?          @map("job_title")
  status         EmploymentStatus @default(pending)
  startDate      DateTime?        @map("start_date") @db.Date
  endDate        DateTime?        @map("end_date") @db.Date
  primarySiteId  String?          @map("primary_site_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  membership      TenantMembership? @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  primarySite     Site?             @relation(fields: [tenantId, primarySiteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)
  teams           TeamMember[]
  documents       Document[]
  onboardingCases OnboardingCase[]
  rtwChecks       RtwCheck[]
  invitations     Invitation[]

  @@unique([tenantId, id])
  @@unique([tenantId, employeeNumber])
  @@unique([tenantId, membershipId])
  @@map("employee")
}

enum EmploymentStatus {
  pending
  active
  left

  @@map("employment_status")
}

// Document metadata only. Storage adapters arrive in Milestone 4 (ADR-0007).
// storage_key must sit under tenants/<tenant_id>/ (CHECK in SQL).
model Document {
  id              String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  ownerEmployeeId String              @map("owner_employee_id") @db.Uuid
  docType         String              @map("doc_type")
  sensitivity     DocumentSensitivity
  storageKey      String              @map("storage_key")
  mimeType        String              @map("mime_type")
  sizeBytes       Int                 @map("size_bytes")
  scanStatus      ScanStatus          @default(pending) @map("scan_status")
  expiresOn       DateTime?           @map("expires_on") @db.Date
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz

  ownerEmployee Employee @relation(fields: [tenantId, ownerEmployeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@unique([storageKey])
  @@index([tenantId, ownerEmployeeId])
  @@map("document")
}

enum DocumentSensitivity {
  standard
  confidential
  restricted

  @@map("document_sensitivity")
}

enum ScanStatus {
  pending
  clean
  quarantined

  @@map("scan_status")
}

// ---------------------------------------------------------------------------
// Platform staff, MFA and platform audit (M5.1, ADR-0013). Global tables used
// ONLY by teamhappi_auth. Platform staff status is never a tenant membership.
// ---------------------------------------------------------------------------

model PlatformStaff {
  userId    String              @id @map("user_id") @db.Uuid
  status    PlatformStaffStatus @default(active)
  grants    String[]            @default([])
  grantedBy String?             @map("granted_by") @db.Uuid
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User  @relation("PlatformStaffUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  granter User? @relation("PlatformStaffGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("platform_staff")
}

enum PlatformStaffStatus {
  active
  suspended
  revoked

  @@map("platform_staff_status")
}

model UserMfa {
  userId           String    @id @map("user_id") @db.Uuid
  secretCiphertext String    @map("secret_ciphertext")
  enabledAt        DateTime? @map("enabled_at") @db.Timestamptz
  lastUsedStep     BigInt?   @map("last_used_step")
  failedAttempts   Int       @default(0) @map("failed_attempts")
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("user_mfa")
}

model MfaRecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("mfa_recovery_code")
}

// Append-only: a trigger rejects UPDATE, DELETE and TRUNCATE.
model PlatformAuditEvent {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  targetUserId String?  @map("target_user_id") @db.Uuid
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  detail       Json     @default("{}")

  @@index([occurredAt(sort: Desc)])
  @@index([targetUserId])
  @@map("platform_audit_event")
}

// ---------------------------------------------------------------------------
// Platform integrations (M5.3, ADR-0011 stage 1, ADR-0012). teamhappi_platform
// only. NON-SECRET settings; credential values are never stored here.
// ---------------------------------------------------------------------------

model IntegrationConfig {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  category    String
  providerId  String    @map("provider_id")
  environment String
  version     Int
  settings    Json      @default("{}")
  validatedAt DateTime? @map("validated_at") @db.Timestamptz
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  activeFor IntegrationActive[]

  @@unique([category, providerId, environment, version], map: "integration_config_version_key")
  @@map("integration_config")
}

model IntegrationActive {
  category    String
  environment String
  providerId  String   @map("provider_id")
  configId    String?  @map("config_id") @db.Uuid
  activatedBy String?  @map("activated_by") @db.Uuid
  activatedAt DateTime @default(now()) @map("activated_at") @db.Timestamptz

  config IntegrationConfig? @relation(fields: [configId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([category, environment])
  @@map("integration_active")
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("platform_setting")
}

// ---------------------------------------------------------------------------
// M6: invitations and the tenant audit trail
// (migration 20261024120000_invitations_members).

enum InvitationStatus {
  pending
  accepted
  revoked

  @@map("invitation_status")
}

// One-time invite link. Only the SHA-256 hash of the token is stored.
model Invitation {
  id         String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  email      String
  roleId     String           @map("role_id") @db.Uuid
  siteId     String?          @map("site_id") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus @default(pending)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  invitedBy  String           @map("invited_by") @db.Uuid
  acceptedBy String?          @map("accepted_by") @db.Uuid
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz
  revokedAt  DateTime?        @map("revoked_at") @db.Timestamptz
  employeeId String?          @map("employee_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role     Role      @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitation_role_fkey")
  site     Site?     @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitation_site_fkey")
  // M7.3: an invitation for a person's record; accepting it links the record.
  employee Employee? @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitation_employee_fkey")

  @@unique([tenantId, id])
  @@map("invitation")
}

// Append-only (trigger). Ids and role keys only; never names or addresses.
model AuditEvent {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  detail      Json     @default("{}")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, occurredAt(sort: Desc)], map: "audit_event_tenant_time")
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// M7.1: onboarding foundation (migration 20261025120000_onboarding_foundation).
// Onboarding belongs to the employee record; no login is needed.

enum OnboardingTemplateScope {
  organisation
  site
  job_title

  @@map("onboarding_template_scope")
}

enum OnboardingTaskCategory {
  task
  document
  induction
  policy

  @@map("onboarding_task_category")
}

enum OnboardingOwnerKind {
  manager
  hr
  employee

  @@map("onboarding_owner_kind")
}

enum OnboardingCaseStatus {
  active
  completed
  cancelled

  @@map("onboarding_case_status")
}

enum OnboardingTaskStatus {
  to_do
  done
  waived

  @@map("onboarding_task_status")
}

model OnboardingTemplate {
  id          String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String                  @map("tenant_id") @db.Uuid
  name        String
  description String?
  scope       OnboardingTemplateScope @default(organisation)
  siteId      String?                 @map("site_id") @db.Uuid
  jobTitle    String?                 @map("job_title")
  isSuggested Boolean                 @default(false) @map("is_suggested")
  version     Int                     @default(1)
  archivedAt  DateTime?               @map("archived_at") @db.Timestamptz
  createdBy   String?                 @map("created_by") @db.Uuid
  createdAt   DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "onboarding_template_tenant_fkey")
  site   Site?                    @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict, onUpdate: Restrict, map: "onboarding_template_site_fkey")
  tasks  OnboardingTemplateTask[]
  cases  OnboardingCase[]

  @@unique([tenantId, id])
  @@map("onboarding_template")
}

model OnboardingTemplateTask {
  id            String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId      String                 @map("tenant_id") @db.Uuid
  templateId    String                 @map("template_id") @db.Uuid
  title         String
  guidance      String?
  category      OnboardingTaskCategory @default(task)
  ownerKind     OnboardingOwnerKind    @default(manager) @map("owner_kind")
  dueOffsetDays Int                    @default(0) @map("due_offset_days")
  required      Boolean                @default(true)
  sortOrder     Int                    @default(0) @map("sort_order")
